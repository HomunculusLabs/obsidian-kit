{
  "name": "obsidian-kit",
  "version": "1.0.0",
  "description": "CLI tool for setting up Obsidian vaults with AI agent integration and spec-driven development",
  "main": "cli/bin/obsidian-kit",
  "bin": {
    "obsidian-kit": "./cli/bin/obsidian-kit"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node cli/bin/obsidian-kit",
    "install-global": "npm install -g .",
    "test": "node scripts/test-runner.js",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:performance": "jest --testPathPattern=tests/performance",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:benchmark": "jest --testPathPattern=tests/performance --json --outputFile=benchmark-results.json",
    "test:comprehensive": "node scripts/test-runner.js",
    "lint": "eslint cli/**/*.js *.js --fix",
    "lint:check": "eslint cli/**/*.js *.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write cli/**/*.js *.js",
    "format:check": "prettier --check cli/**/*.js *.js",
    "prepare": "npm run build",
    "precommit": "npm run lint:check && npm run typecheck && npm run test:unit",
    "dev-setup": "node scripts/dev-setup.js",
    "clean": "rm -rf dist node_modules/.cache coverage test-report.json test-report.html",
    "start": "node cli/bin/obsidian-kit",
    "deploy:staging": "node scripts/deploy.js staging",
    "deploy:production": "node scripts/deploy.js production",
    "rollback": "node scripts/rollback.js",
    "rollback:list": "node scripts/rollback.js list",
    "rollback:history": "node scripts/rollback.js history"
  },
  "keywords": [
    "obsidian",
    "ai-agents",
    "mcp",
    "project-management",
    "spec-kit",
    "documentation"
  ],
  "author": "t3rpz",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.0.0",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6",
    "fs-extra": "^11.0.0",
    "yaml": "^2.3.0",
    "semver": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/inquirer": "^8.2.0",
    "@types/fs-extra": "^11.0.0",
    "@types/jest": "^29.0.0",
    "@types/semver": "^7.5.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "jest": "^29.0.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0",
    "audit-ci": "^6.0.0",
    "supertest": "^6.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run precommit"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}